{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/moonshotai/kimi-k3",
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "task": "allow",
    "external_directory": "deny"
  },
  "provider": {
    "openrouter": {
      "models": {
        "moonshotai/kimi-k3": {},
        "moonshotai/kimi-k2": {},
        "minimax/minimax-m3": {},
        "z-ai/glm-5.2": {},
        "xiaomi/mimo-v2.5": {},
        "deepseek/deepseek-v4-pro": {}
      }
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  }
}
